# ------------------------------------------------------------------
# API server (server/index.js)
# ------------------------------------------------------------------

# Postgres connection string. On Vercel: create a Neon database from the
# Storage tab and DATABASE_URL is injected automatically — nothing to copy.
# Local: leave it EMPTY — an embedded Postgres (PGlite) is used automatically.
DATABASE_URL=

# Port the API server listens on (dev default: 3001)
PORT=3001

# Single admin account for /admin (CHANGE BEFORE GOING LIVE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Public base URL for image links in production (e.g. https://skfurniture.vercel.app)
# Leave empty in development — the server figures it out from the request.
PUBLIC_API_BASE=

# ------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------

# Base URL of the API. Leave empty when using `npm run dev:all` or when the
# Express server serves the built SPA (same origin). Set it when the SPA is
# hosted on a different domain than the API, e.g. https://api.example.com
VITE_API_URL=
